    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "npm run build:app && nodemon",
        "build:lib": "vite build",
        "build:app": "vite build -c vite.config.app.ts",
        "build:server": "tsc --outDir dist-server",
        "build": "npm run build:lib && npm run build:app && npm run build:server",
        "serve": "node dist-server/server.js"
    },
